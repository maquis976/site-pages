# ── OS junk ──────────────────────────────                                                     
  .DS_Store                                             
  .DS_Store?
  ._*                                                                                             
  .Spotlight-V100
  .Trashes                                                                                        
  Thumbs.db                                             
  desktop.ini
                                                                                                  
  # ── Editor / IDE junk ────────────────────
  *.swp                                                                                           
  *.swo                                                 
  *~
  .vscode/
  .idea/
  .project
  *.sublime-*                                                                                     
  
  # ── Defensive: never commit secrets ──────                                                     
  # None of these should ever exist in this repo,       
  # but if they accidentally appear, git will ignore them.                                        
  .env                                                                                            
  .env.*                                                                                          
  *.key                                                                                           
  *.pem                                                 
  *.p12
  *.pfx
  credentials.json
  token.json                                                                                      
  *_credentials.json
  *_token.json                                                                                    
  secrets/                                              
  .secrets/
  *.secret
                                                                                                  
  # ── Logs and scratch files ───────────────
  *.log                                                                                           
  logs/                                                 
  tmp/
  scratch/                                                                                        
  
  # ── Python (in case you ever add a build script) ──                                            
  __pycache__/                                          
  *.pyc                                                                                           
  *.pyo                                                 
  .venv/
  venv/
